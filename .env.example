# All settings are optional in development. In production OLISTFLOW_ENV=production REQUIRES a real JWT secret.
OLISTFLOW_ENV=dev
OLISTFLOW_JWT_SECRET=change-me-to-a-long-random-string-of-32+bytes
OLISTFLOW_DB_PATH=olist_flow.db
OLISTFLOW_RATE_LIMIT=300
OLISTFLOW_FLAKINESS=0.4        # scale of random carrier-API failures (0 disables)
# Per-user passwords (otherwise: dev = "olistflow-dev", production = random, logged once)
# OLISTFLOW_ADMIN_PASSWORD=
# OLISTFLOW_OPS_PASSWORD=
# OLISTFLOW_ANALYST_PASSWORD=
# OLISTFLOW_SELLER_PASSWORD=

# Real-data calibration: path to an alternative artifact, or "none" to force the original synthetic physics
# OLISTFLOW_CALIBRATION=
